# Copy this file to .env and adjust it. The server, migrate and bootstrap
# commands read .env from the folder you run them in. Real environment
# variables always take precedence over this file.

# --- required -----------------------------------------------------------------
# user:password@tcp(host:port)/database
# parseTime, UTC and utf8mb4 are applied automatically; you do not need to add them.
MES_DSN=mes:change-this-password@tcp(127.0.0.1:3306)/mes

# --- server ---------------------------------------------------------------------
MES_ENV=development            # development | test | production
MES_ADDR=:8080
MES_LOG_LEVEL=info             # debug | info | warn | error
# MES_LOG_FORMAT=text          # text | json (json is the default in production)

# --- sessions and sign-in (BR-1.6, BR-1.8) --------------------------------------
MES_SESSION_IDLE=30m
MES_SESSION_MAX=12h
MES_MAX_LOGIN_ATTEMPTS=5
MES_LOCKOUT=15m
MES_LOGIN_PER_MINUTE=10

# --- second factor (BR-1.3) -----------------------------------------------------
# Always on in production. Set it to true here to try the full sign-in flow
# with an authenticator app locally.
MES_REQUIRE_MFA=false
MES_MFA_CHALLENGE_TTL=5m
# MES_MFA_ISSUER=Medical Expert System

# --- deployment -----------------------------------------------------------------
# Apply pending migrations at start-up. Default: on outside production, off in
# production (run the migrate command as a deployment step instead).
# MES_AUTO_MIGRATE=true

# Only behind a reverse proxy that sets X-Forwarded-For. Otherwise any client
# can forge its address and walk past the rate limiter.
MES_TRUST_PROXY_HEADERS=false

# --- connection pool ------------------------------------------------------------
# MES_DB_MAX_OPEN=25
# MES_DB_MAX_IDLE=10
# MES_DB_CONN_MAX_LIFE=5m
# MES_DB_CONN_MAX_IDLE=2m
