# Copy this file to .env and adjust it. The server, migrate and bootstrap
# commands read .env from the folder you run them in. Real environment
# variables always take precedence over this file.

# --- required -----------------------------------------------------------------
# user:password@tcp(host:port)/database
# parseTime, UTC and utf8mb4 are applied automatically; you do not need to add them.
MES_DSN=mes:change-this-password@tcp(127.0.0.1:3306)/mes

# --- server ---------------------------------------------------------------------
MES_ENV=development            # development | test | production
MES_ADDR=:8080
MES_LOG_LEVEL=info             # debug | info | warn | error
# MES_LOG_FORMAT=text          # text | json (json is the default in production)

# --- sessions and sign-in (BR-1.6, BR-1.8) --------------------------------------
MES_SESSION_IDLE=30m
MES_SESSION_MAX=12h
MES_MAX_LOGIN_ATTEMPTS=5
MES_LOCKOUT=15m
MES_LOGIN_PER_MINUTE=10

# --- second factor (BR-1.3) -----------------------------------------------------
# Always on in production. Set it to true here to try the full sign-in flow
# with an authenticator app locally.
MES_REQUIRE_MFA=false
MES_MFA_CHALLENGE_TTL=5m
# MES_MFA_ISSUER=Medical Expert System

# --- deployment -----------------------------------------------------------------
# Apply pending migrations at start-up. Default: on outside production, off in
# production (run the migrate command as a deployment step instead).
# MES_AUTO_MIGRATE=true

# Only behind a reverse proxy that sets X-Forwarded-For. Otherwise any client
# can forge its address and walk past the rate limiter.
MES_TRUST_PROXY_HEADERS=false

# --- AI note drafting (stage 2) --------------------------------------------------
# Leave the key empty until a data processing agreement with Anthropic is in
# place: drafting is then switched off and everything else works.
ANTHROPIC_API_KEY=
# MES_AI_MODEL=claude-sonnet-5-5
# MES_AI_BASE_URL=https://api.anthropic.com
# MES_AI_TIMEOUT=90s
# Drafting requests per practice per day, failed attempts included.
MES_AI_DAILY_LIMIT=200

# --- chronic care ---------------------------------------------------------------
# A repeat prescription for a patient not reviewed in a signed note within this
# many months needs an override reason. Patients can have their own interval.
MES_DEFAULT_REVIEW_MONTHS=6

# --- WhatsApp reminders (stage 3) ----------------------------------------------
# See docs/WHATSAPP.md. Leave these empty and nothing is ever sent; everything
# else works. With them set, each practice still switches messaging on in its
# own settings before any of its patients hears from it.
MES_WHATSAPP_PHONE_NUMBER_ID=
MES_WHATSAPP_ACCESS_TOKEN=
# Checks the signature on every webhook. Without it every webhook is refused,
# so patients' replies and delivery receipts are never recorded.
MES_WHATSAPP_APP_SECRET=
# Any long random string; give Meta the same one when setting up the webhook.
MES_WHATSAPP_VERIFY_TOKEN=
# MES_WHATSAPP_API_VERSION=v23.0
# MES_WHATSAPP_LANGUAGE=en
# Second reminder for doses still unanswered: 10m to 12h, or off.
# MES_REMINDER_FOLLOW_UP=60m
# Messages per practice per day.
MES_NOTIFICATION_DAILY_LIMIT=1000

# --- doses ------------------------------------------------------------------------
# How long a dose stays answerable before it is closed as missed. A patient who
# confirms an 08:00 dose at 11:00 has taken it.
MES_DOSE_GRACE=12h

# --- connection pool ------------------------------------------------------------
# MES_DB_MAX_OPEN=25
# MES_DB_MAX_IDLE=10
# MES_DB_CONN_MAX_LIFE=5m
# MES_DB_CONN_MAX_IDLE=2m
